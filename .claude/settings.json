{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm test *)",
      "Bash(npm run check)",
      "Bash(npm run test:e2e)",
      "Bash(npm run bench)",
      "Bash(node --test *)",
      "Bash(npx tsc *)",
      "Bash(cp wrangler.example.jsonc wrangler.jsonc)",
      "Bash(gitleaks git *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rebase origin/main)",
      "Bash(git push -u origin duet/*)",
      "Bash(git push origin duet/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Edit(./.github/**)",
      "Edit(./package-lock.json)"
    ],
    "deny": [
      "Bash(npm run deploy *)",
      "Bash(wrangler *)",
      "Bash(npx wrangler deploy *)",
      "Bash(npx wrangler versions *)",
      "Bash(npx wrangler rollback *)",
      "Bash(npx wrangler secret *)",
      "Bash(npx wrangler delete *)",
      "Bash(npx wrangler login *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git worktree *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo *)",
      "Bash(gh secret *)",
      "Bash(gh api *)",
      "Read(./.dev.vars)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.dev.vars)",
      "Edit(./.env)",
      "Edit(./.env.*)"
    ]
  }
}

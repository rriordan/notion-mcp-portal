{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "notion-api-mcp",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },

  // Served only on its own hostname; workers.dev and preview URLs are off so the
  // Access check can't be bypassed through another URL.
  "workers_dev": false,
  "preview_urls": false,
  // Replace with a hostname on a zone in your Cloudflare account.
  "routes": [{ "pattern": "notion.example.com", "custom_domain": true }],

  "vars": {
    // Your Zero Trust team domain.
    "ACCESS_TEAM_DOMAIN": "your-team.cloudflareaccess.com",
    // Paste the AUD tag of the Access app that protects the hostname above, then redeploy.
    // Until it's set, every request is rejected (fail closed).
    "ACCESS_AUD": ""
  }
  // Secret (not in this file): npx wrangler secret put NOTION_TOKEN
}
